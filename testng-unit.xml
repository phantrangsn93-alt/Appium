<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Framework unit tests: no device / Appium needed. -->
<suite name="Framework unit" parallel="classes" thread-count="2">
    <test name="unit">
        <classes>
            <class name="vn.bsc.automation.unit.LocatorsTest"/>
            <class name="vn.bsc.automation.unit.OrderDataTest"/>
            <class name="vn.bsc.automation.unit.OrderBookMatchTest"/>
        </classes>
    </test>
    <!-- separate <test>: switches platform.name=iOS for its own classes, must not run in parallel with Android ones -->
    <test name="iOS platform (no device)">
        <classes>
            <class name="vn.bsc.automation.unit.IosPlatformTest"/>
        </classes>
    </test>
</suite>
