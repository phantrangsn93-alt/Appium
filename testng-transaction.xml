<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  BỘ GIAO DỊCH (giao dịch thật) - chạy liền một mạch theo thứ tự:
    1. Đăng nhập thành công (Excel No.1)
    2. Đặt lệnh / sửa / huỷ / huỷ tất cả (orders.csv + order_actions.csv), tự huỷ lệnh test còn lại
       (thứ tự: lệnh thường -> sửa/huỷ -> lệnh điều kiện + TP/SL)
    3. Giao dịch tiền / chứng khoán trong Menu (menu_transactions.csv; prod: menu_transactions_prod.csv 10,000 VND)
    4. Tab Giao dịch (Sổ lệnh / Danh mục / Tài sản) và Menu: Quản lý tài khoản / Tiện ích / Cài đặt (chỉ xem)
    5. Đối chiếu sau giao dịch: Sổ lệnh không còn lệnh test, Lịch sử đặt lệnh, Sao kê tiền (tiểu khoản chuyển / nhận)
  UAT : mvn test -Dsuite=testng-transaction.xml                (env=uat trong .env)
  PROD: mvn test -Dsuite=testng-transaction.xml -Denv=prod     (chỉ khi chủ tài khoản cho phép; tự nhập OTP)
-->
<suite name="BSC Giao dịch (real)" verbose="1">
    <listeners>
        <listener class-name="vn.bsc.automation.listeners.TestListener"/>
    </listeners>
    <test name="Giao dịch" preserve-order="true">
        <classes>
            <class name="vn.bsc.automation.tests.excel.ExcelLoginTest"/>
            <class name="vn.bsc.automation.tests.excel.ExcelOrderTest"/>
            <class name="vn.bsc.automation.tests.menu.MenuTransactionTest"/>
            <class name="vn.bsc.automation.tests.order.TradingInfoTest"/>
            <class name="vn.bsc.automation.tests.menu.AccountInfoTest"/>
            <class name="vn.bsc.automation.tests.menu.StatementTest"/>
            <class name="vn.bsc.automation.tests.menu.PostTransactionCheckTest"/>
        </classes>
    </test>
</suite>
