<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Phase B - login/logout + REAL orders (UAT: order.submit.enabled=true in config-uat.properties).
  Credentials / PIN from .env. Every accepted order is verified (message, order book status, balance) and
  every order created by the run is cancelled at the end (safety net).
-->
<suite name="BSC Phase B - transactions" verbose="1">
    <listeners>
        <listener class-name="vn.bsc.automation.listeners.TestListener"/>
    </listeners>
    <test name="Phase B" preserve-order="true">
        <classes>
            <class name="vn.bsc.automation.tests.login.LoginTest"/>
            <class name="vn.bsc.automation.tests.excel.ExcelLoginTest"/>
            <class name="vn.bsc.automation.tests.excel.ExcelOrderTest"/>
        </classes>
    </test>
</suite>
