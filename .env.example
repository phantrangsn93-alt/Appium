# Copy this file to .env and fill in real values. .env is git-ignored - NEVER commit it.
# Valid test account used by "valid login" test and by ensureLoggedIn() for post-login suites.
BSC_USERNAME=
BSC_PASSWORD=

# Order PIN, typed automatically on the order confirm dialog (place / modify / cancel).
# Leave empty to have the tester type the PIN on the phone.
BSC_ORDER_PIN=

# Environment: sit (default) | uat. UAT enables real order submission (see config-uat.properties).
# ENV=uat

# Sub-account names of YOUR account (test data uses types CO_SO | MARGIN | PHAI_SINH).
# Defaults for the UAT test account are in config-uat.properties; override here if your account differs.
# SUBACCOUNT_COSO=Thường
# SUBACCOUNT_MARGIN=MR10+ BSC
# SUBACCOUNT_PHAISINH=Phaisinh

# Optional overrides (same keys as config.properties, upper-case with dots -> underscores)
# DEVICE_UDID=dabfffa4
# APPIUM_SERVER_URL=http://127.0.0.1:4723
# ANDROID_HOME=/Users/<you>/Library/Android/sdk
