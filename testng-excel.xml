<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Kịch bản từ file "Kịch bản kiểm thử sau khi update App.xlsx".
  Cần người kiểm thử cạnh điện thoại: test DỪNG CHỜ nhập username/password/PIN trên máy.
  Kịch bản đặt lệnh THẬT chỉ chạy khi:  mvn test -Dsuite=testng-excel.xml -Dorder.submit.enabled=true
-->
<suite name="BSC Excel scenarios" verbose="1">
    <listeners>
        <listener class-name="vn.bsc.automation.listeners.TestListener"/>
    </listeners>
    <test name="Excel" preserve-order="true">
        <classes>
            <class name="vn.bsc.automation.tests.excel.ExcelLoginTest"/>
            <!-- Pre-check: fill the form for every row of orders.csv WITHOUT submitting -->
            <class name="vn.bsc.automation.tests.excel.OrderDryRunTest"/>
            <!-- No.2-8: data-driven from testdata/orders.csv + order_actions.csv; skipped unless -Dorder.submit.enabled=true -->
            <class name="vn.bsc.automation.tests.excel.ExcelOrderTest"/>
        </classes>
    </test>
</suite>
