<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Parallel run on several devices/emulators.
  1. Configure the pool:   -Ddevices=udid1:8200,udid2:8201      (or "devices=" in config.properties)
  2. thread-count = number of devices
  Each CLASS borrows a free device for its whole duration (DevicePool), classes run concurrently.
  NOT included: LoginTest (logs out) and ExcelOrderTest (real orders, one order book) - run them separately.
  Note: with ONE trading account, check that the broker allows simultaneous logins on several devices.
-->
<suite name="BSC Parallel" parallel="classes" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="vn.bsc.automation.listeners.TestListener"/>
        <listener class-name="vn.bsc.automation.listeners.RetryTransformer"/>
    </listeners>
    <test name="Read-only suites">
        <classes>
            <class name="vn.bsc.automation.tests.navigation.NavigationTest"/>
            <class name="vn.bsc.automation.tests.priceboard.PriceBoardTest"/>
            <class name="vn.bsc.automation.tests.order.OrderFormTest"/>
            <class name="vn.bsc.automation.tests.order.TradingInfoTest"/>
            <class name="vn.bsc.automation.tests.search.SearchTest"/>
        </classes>
    </test>
</suite>
